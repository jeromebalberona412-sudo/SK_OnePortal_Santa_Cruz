-- ============================================================
-- ABYIP DATABASE SCHEMA
-- Laravel + Supabase
-- ============================================================

-- UUID generation
CREATE EXTENSION IF NOT EXISTS pgcrypto;


-- ============================================================
-- 1. ABYIP DOCUMENTS
-- ============================================================

CREATE TABLE IF NOT EXISTS public.abyips (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    -- Document information
    title TEXT NOT NULL DEFAULT 'Annual Barangay Youth Investment Program',
    year INTEGER NOT NULL,

    -- Location
    barangay TEXT,
    municipality TEXT,
    province TEXT,

    -- Budget information from the document
    estimated_barangay_budget NUMERIC(15,2) NOT NULL DEFAULT 0.00,
    sk_fund NUMERIC(15,2) NOT NULL DEFAULT 0.00,

    -- Source PDF
    original_filename TEXT,
    source_file_path TEXT,
    source_file_url TEXT,

    -- Import information
    import_status TEXT NOT NULL DEFAULT 'draft'
        CHECK (
            import_status IN (
                'draft',
                'processing',
                'review',
                'confirmed',
                'failed',
                'cancelled'
            )
        ),

    extraction_method TEXT
        CHECK (
            extraction_method IS NULL
            OR extraction_method IN (
                'pdf_text',
                'pdf_table',
                'camelot',
                'pdfplumber',
                'pymupdf',
                'paddleocr',
                'mixed',
                'manual'
            )
        ),

    extraction_confidence NUMERIC(5,2),

    manual_review_required BOOLEAN NOT NULL DEFAULT FALSE,

    created_by UUID,

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),

    -- Prevent duplicate ABYIP for same location/year
    CONSTRAINT unique_abyip_location_year
        UNIQUE (
            barangay,
            municipality,
            province,
            year
        )
);


-- ============================================================
-- 2. ABYIP ITEMS
-- ============================================================

CREATE TABLE IF NOT EXISTS public.abyip_items (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    -- Parent ABYIP
    abyip_id UUID NOT NULL,

    -- PDF table information
    code TEXT,

    -- Hierarchy
    program TEXT,
    category TEXT,
    ppa TEXT,

    -- Details
    description TEXT,
    expected_result TEXT,
    performance_indicator TEXT,

    -- Implementation period
    implementation_start DATE,
    implementation_end DATE,
    implementation_period_original TEXT,

    -- Person responsible
    person_responsible TEXT,

    -- Budget
    mooe NUMERIC(15,2) NOT NULL DEFAULT 0.00,
    co NUMERIC(15,2) NOT NULL DEFAULT 0.00,
    total NUMERIC(15,2) NOT NULL DEFAULT 0.00,

    -- Extraction information
    extraction_confidence NUMERIC(5,2),

    manual_review_required BOOLEAN NOT NULL DEFAULT FALSE,

    validation_status TEXT NOT NULL DEFAULT 'pending'
        CHECK (
            validation_status IN (
                'pending',
                'valid',
                'warning',
                'error'
            )
        ),

    validation_message TEXT,

    -- Preserve original extracted budget text if needed
    original_budget_text TEXT,

    -- Source page/row information
    source_page INTEGER,
    source_row INTEGER,

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),

    CONSTRAINT fk_abyip_items_abyip
        FOREIGN KEY (abyip_id)
        REFERENCES public.abyips(id)
        ON DELETE CASCADE
);


-- ============================================================
-- 3. IMPORT LOGS
-- ============================================================

CREATE TABLE IF NOT EXISTS public.abyip_import_logs (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    abyip_id UUID,

    original_filename TEXT,

    status TEXT NOT NULL DEFAULT 'processing'
        CHECK (
            status IN (
                'processing',
                'success',
                'failed',
                'cancelled'
            )
        ),

    extraction_method TEXT,

    total_rows_detected INTEGER NOT NULL DEFAULT 0,
    total_rows_saved INTEGER NOT NULL DEFAULT 0,
    total_rows_reviewed INTEGER NOT NULL DEFAULT 0,

    total_mooe NUMERIC(15,2) NOT NULL DEFAULT 0.00,
    total_co NUMERIC(15,2) NOT NULL DEFAULT 0.00,
    total_budget NUMERIC(15,2) NOT NULL DEFAULT 0.00,

    source_document_total NUMERIC(15,2),

    difference NUMERIC(15,2),

    warnings JSONB NOT NULL DEFAULT '[]'::JSONB,
    errors JSONB NOT NULL DEFAULT '[]'::JSONB,

    created_by UUID,

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),

    CONSTRAINT fk_import_logs_abyip
        FOREIGN KEY (abyip_id)
        REFERENCES public.abyips(id)
        ON DELETE CASCADE
);


-- ============================================================
-- 4. INDEXES
-- ============================================================

CREATE INDEX IF NOT EXISTS idx_abyips_year
ON public.abyips(year);

CREATE INDEX IF NOT EXISTS idx_abyips_barangay
ON public.abyips(barangay);

CREATE INDEX IF NOT EXISTS idx_abyips_status
ON public.abyips(import_status);

CREATE INDEX IF NOT EXISTS idx_abyip_items_abyip_id
ON public.abyip_items(abyip_id);

CREATE INDEX IF NOT EXISTS idx_abyip_items_program
