CREATE INDEX IF NOT EXISTS idx_abyip_items_ppa
ON public.abyip_items(ppa);

CREATE INDEX IF NOT EXISTS idx_abyip_items_person
ON public.abyip_items(person_responsible);

CREATE INDEX IF NOT EXISTS idx_abyip_items_validation
ON public.abyip_items(validation_status);

CREATE INDEX IF NOT EXISTS idx_import_logs_abyip
ON public.abyip_import_logs(abyip_id);


-- ============================================================
-- 5. AUTOMATIC UPDATED_AT
-- ============================================================

CREATE OR REPLACE FUNCTION public.set_updated_at()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN
    NEW.updated_at = NOW();
    RETURN NEW;
END;
$$;


DROP TRIGGER IF EXISTS trg_abyips_updated_at
ON public.abyips;

CREATE TRIGGER trg_abyips_updated_at
BEFORE UPDATE ON public.abyips
FOR EACH ROW
EXECUTE FUNCTION public.set_updated_at();


DROP TRIGGER IF EXISTS trg_abyip_items_updated_at
ON public.abyip_items;

CREATE TRIGGER trg_abyip_items_updated_at
BEFORE UPDATE ON public.abyip_items
FOR EACH ROW
EXECUTE FUNCTION public.set_updated_at();


-- ============================================================
-- 6. BUDGET VALIDATION FUNCTION
-- ============================================================

CREATE OR REPLACE FUNCTION public.validate_abyip_item_budget()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN

    -- Prevent negative amounts
    IF NEW.mooe < 0 THEN
        RAISE EXCEPTION 'MOOE cannot be negative';
    END IF;

    IF NEW.co < 0 THEN
        RAISE EXCEPTION 'CO cannot be negative';
    END IF;

    IF NEW.total < 0 THEN
        RAISE EXCEPTION 'Total cannot be negative';
    END IF;

    -- Automatically determine validation status
    IF ROUND(NEW.mooe + NEW.co, 2) = ROUND(NEW.total, 2) THEN

        IF NEW.manual_review_required = TRUE THEN
            NEW.validation_status = 'warning';
        ELSE
            NEW.validation_status = 'valid';
        END IF;

        NEW.validation_message =
            'MOOE + CO matches Total.';

    ELSE

        NEW.validation_status = 'warning';

        NEW.validation_message =
            'MOOE + CO does not match Total. Manual review required.';

        NEW.manual_review_required = TRUE;

    END IF;

    RETURN NEW;

END;
$$;


DROP TRIGGER IF EXISTS trg_validate_abyip_budget
ON public.abyip_items;

CREATE TRIGGER trg_validate_abyip_budget
BEFORE INSERT OR UPDATE ON public.abyip_items
FOR EACH ROW
EXECUTE FUNCTION public.validate_abyip_item_budget();


-- ============================================================
-- 7. VIEW FOR EASY ABYIP REPORTING
-- ============================================================

CREATE OR REPLACE VIEW public.abyip_items_with_document
AS
SELECT
    i.id,
    i.abyip_id,

    a.year,
    a.barangay,
    a.municipality,
    a.province,

    i.code,
    i.program,
    i.category,
    i.ppa,

    i.description,
    i.expected_result,
    i.performance_indicator,

    i.implementation_start,
    i.implementation_end,

    i.person_responsible,

    i.mooe,
    i.co,
    i.total,

    i.extraction_confidence,
    i.manual_review_required,

    i.validation_status,
    i.validation_message,

    i.source_page,
    i.source_row,

    i.created_at,
    i.updated_at

FROM public.abyip_items i

INNER JOIN public.abyips a
    ON a.id = i.abyip_id;


-- ============================================================
-- 8. VIEW FOR ABYIP TOTALS
-- ============================================================

CREATE OR REPLACE VIEW public.abyip_budget_summary
AS
SELECT
    a.id AS abyip_id,

    a.year,
    a.barangay,
    a.municipality,
    a.province,

    a.estimated_barangay_budget,
    a.sk_fund,

    COALESCE(SUM(i.mooe), 0.00) AS calculated_mooe,
    COALESCE(SUM(i.co), 0.00) AS calculated_co,
    COALESCE(SUM(i.total), 0.00) AS calculated_total,

    COUNT(i.id) AS total_items,

    COALESCE(
        SUM(
            CASE
                WHEN i.validation_status = 'valid'
                THEN 1
                ELSE 0
            END
        ),
        0
    ) AS valid_items,

    COALESCE(
        SUM(
            CASE
                WHEN i.manual_review_required = TRUE
                THEN 1
                ELSE 0
            END
        ),
        0
    ) AS items_requiring_review

FROM public.abyips a

LEFT JOIN public.abyip_items i
    ON i.abyip_id = a.id

GROUP BY
    a.id,
    a.year,
    a.barangay,
    a.municipality,
    a.province,
    a.estimated_barangay_budget,
    a.sk_fund;


